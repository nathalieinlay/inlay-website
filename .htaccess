# inlay.info is one page. Old addresses and profile links go to the right place on it.
RewriteEngine On
RewriteRule ^privacy(\.html)?$ /#privacy [R=301,NE,L]
RewriteRule ^terms(\.html)?$ /#terms [R=301,NE,L]
RewriteRule ^support(\.html)?$ /#support [R=301,NE,L]
RewriteRule ^pro(\.html)?$ /#pro [R=301,NE,L]
RewriteRule ^@ / [R=302,L]
